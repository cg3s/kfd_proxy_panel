PORT=3000
HOST=0.0.0.0
DATABASE_PATH=.\db\kafuda.sqlite
KAFUDA_API_KEY=vk_replace_me
GATEWAY_API_TOKEN=replace_with_a_long_random_secret
KAFUDA_WEBHOOK_SECRET=whsec_replace_me
DASHBOARD_PASSWORD=replace_with_a_different_long_random_password
COOKIE_SECURE=false
PUBLIC_BASE_URL=https://your-domain.example
EPAY_BASE_URL=https://payment-provider.example
EPAY_PID=replace_with_merchant_id
EPAY_KEY=replace_with_payment_key
EPAY_TYPE=alipay
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace_with_smtp_username
SMTP_PASSWORD=replace_with_smtp_password
SMTP_FROM=卡付达平台 <no-reply@your-domain.example>
# Required to enable CDK purchasing; passed as funding_cap_cents to the upstream batch request.
CDK_FUNDING_CAP_CENTS=0
